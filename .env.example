# Copy this file to .env and update values before deploying
# PostgreSQL credentials (used by docker-compose)
# This project will run Postgres in "trust" (no password) mode by default.
# On the container we set POSTGRES_HOST_AUTH_METHOD=trust which disables password auth
# WARNING: This is insecure and should only be used in local/dev or private networks.
POSTGRES_USER=postgres
POSTGRES_DB=LinguaTech
POSTGRES_HOST_AUTH_METHOD=trust

# ASP.NET environment
ASPNETCORE_ENVIRONMENT=Production

# Optional: override JWT key in production (recommend using secret manager or env var on host)
# JWT_KEY=your_super_secret_jwt_key_here
